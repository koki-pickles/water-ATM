# Copy this file to .env (same folder) and fill in your own values.
# .env is ignored by git, so your keys stay on your laptop.

# Daraja portal -> My Apps -> your app
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# Public tunnel URL to your laptop (printed by cloudflared), no trailing slash
MPESA_CALLBACK_BASE_URL=

# Any long random string, e.g. output of: openssl rand -hex 16
MPESA_CALLBACK_SECRET=
